{
  "name": "raceultimate-track-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "dev": "node scripts/sync-assets.mjs && vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "node scripts/sync-assets.mjs && vite build",
    "pack:ktx2": "node scripts/pack-ktx2.mjs",
    "test:track": "node scripts/test-track.mjs",
    "pack": "node scripts/pack-web.mjs",
    "derive:cars": "node scripts/derive-car-lods.mjs",
    "qa": "node scripts/car-qa.mjs",
    "trace": "node scripts/car-trace.mjs",
    "test:v2": "node --test scripts/test-v2.mjs && node scripts/test-menu.mjs",
    "pack:cars": "node scripts/pack-car-textures.mjs",
    "test:car-textures": "node scripts/test-car-textures.mjs",
    "test:loading": "node --test scripts/test-loading.mjs && node scripts/test-menu.mjs",
    "test:sponsors": "node scripts/test-sponsor-assets.mjs",
    "test:team-logos": "node scripts/test-team-logos.mjs",
    "test:driver-intro": "node scripts/test-driver-intro.mjs",
    "test:brake-lights": "node scripts/test-brake-lights.mjs",
    "test:traction": "node scripts/test-traction.mjs",
    "test:race-loading": "node scripts/test-race-loading.mjs && node scripts/test-driver-intro.mjs",
    "test:commentary": "node scripts/test-commentary-mix.mjs",
    "test:pedals": "node scripts/test-pedals.mjs",
    "test:arcade": "node scripts/test-arcade.mjs",
    "test:hoardings": "node scripts/test-hoardings.mjs",
    "pack:shells": "node scripts/shell-venue.mjs",
    "pack:sectors": "node scripts/partition-venue.mjs",
    "test:sectors": "node scripts/test-sectors.mjs && node scripts/test-culling.mjs",
    "test:scenery-lod": "node scripts/test-scenery-yachts.mjs && node scripts/test-scenery-buildings.mjs && node scripts/test-culling.mjs",
    "test:turning": "node scripts/physics-turning.mjs --only arcade,steady,turnin,ice,lift,trail,rwd,handbrake,slalom,abuse,hairpin,assert",
    "test:braking": "node scripts/physics-braking.mjs",
    "test:dynres": "node scripts/test-dynres.mjs",
    "test:hud": "node src/game/hud-smoke.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/limelight": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/racing-sans-one": "^5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "playwright-core": "^1.56.1",
    "sharp": "0.35.5",
    "vite": "8.3.4"
  }
}
